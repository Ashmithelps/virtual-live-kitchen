# Hygiene service settings (all optional except the API key outside local development).

# Shared secret: the backend sends it as X-Api-Key (backend: AI_SERVICE_API_KEY). Generate with: openssl rand -hex 32
AI_SERVICE_API_KEY=change_me

# Detector weights and the mapping of its class names onto ours (see README "Swapping the model").
HYGIENE_MODEL_PATH=models/hygiene.pt
HYGIENE_CLASS_MAP_PATH=models/class_map.yaml
# Optional label stored with results; default "<file>@<sha256 prefix>".
HYGIENE_MODEL_VERSION=

CONFIDENCE=0.35
SAMPLE_FPS=1
MAX_FRAMES=180
MAX_VIDEO_MB=200
DOWNLOAD_TIMEOUT_S=60
# Hosts ("host:port" or "host") videos may be fetched from: your S3 endpoint as the service sees it.
# Production (Cloudflare R2): <account-id>.r2.cloudflarestorage.com
ALLOWED_VIDEO_HOSTS=localhost:9000,127.0.0.1:9000,minio:9000
MAX_CONCURRENT=1
# "json" in production (one JSON object per log line; the Docker image sets this), "text" locally.
LOG_FORMAT=text
