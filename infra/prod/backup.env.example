# /opt/vlk/backup.env on the server. Same keys as infra/backup/.env.example.
# Managed Postgres, read-only credentials are enough (create a dedicated backup role; see PRODUCTION.md).
PGHOST=your-db-host.example.com
PGPORT=5432
PGDATABASE=virtualkitchen
PGUSER=vlk_backup
PGPASSWORD=change_me
PGSSLMODE=require

# Cloudflare R2 bucket for backups (separate from the media/clips buckets; token scoped to this bucket only).
BACKUP_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
BACKUP_S3_BUCKET=vlk-db-backups
BACKUP_S3_PREFIX=postgres
AWS_ACCESS_KEY_ID=change_me
AWS_SECRET_ACCESS_KEY=change_me
AWS_DEFAULT_REGION=auto

# Daily at this UTC time (21:00 UTC = 02:30 IST); backups older than the retention are deleted.
BACKUP_AT=21:00
BACKUP_RETENTION_DAYS=30
# Optional: encrypt each dump with age (public key "age1..."); keep the private key OFF the server.
BACKUP_AGE_RECIPIENT=
# Optional: healthchecks.io-style URL pinged after each successful backup (and <url>/fail on failure).
BACKUP_HEARTBEAT_URL=
