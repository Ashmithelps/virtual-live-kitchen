# /opt/vlk/.env on the server: variables for docker-compose.prod.yml (not secrets).
API_DOMAIN=api.example.in
ACME_EMAIL=ops@example.in
# Container registry CI pushes to (lowercase), and the tag currently deployed (deploy.sh rewrites it).
IMAGE_REGISTRY=ghcr.io/your-github-user
IMAGE_TAG=main
# Memory caps on an 8 GB VM; the AI service needs ~2 GB while analysing.
BACKEND_MEM_LIMIT=3g
AI_MEM_LIMIT=3g
