# /opt/vlk/backend.env on the server. SPRING_PROFILES_ACTIVE=prod is set by docker-compose.prod.yml, and
# ProductionGuard refuses to start if anything below still has a development value.
# Generate secrets with: openssl rand -hex 32 (JWT: openssl rand -base64 48)

# Managed Postgres (sslmode=require; verify-full once you add the provider's CA)
DB_URL=jdbc:postgresql://your-db-host.example.com:5432/virtualkitchen?sslmode=require
DB_USERNAME=vlk_app
DB_PASSWORD=change_me

JWT_SECRET=change_me
# First admin: created once on startup if no user has this phone; remove ADMIN_PASSWORD afterwards (PRODUCTION.md).
ADMIN_NAME="Platform Admin"
ADMIN_PHONE=+91XXXXXXXXXX
ADMIN_PASSWORD=change_me

# Public addresses
WEB_BASE_URL=https://example.in
CORS_ALLOWED_ORIGINS=https://example.in,https://www.example.in
BACKEND_PROXY_SECRET=change_me

# Cloudflare R2 (S3 API). Buckets and their CORS are created by hand; the token is scoped to these two buckets.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=change_me
S3_SECRET_KEY=change_me
S3_BUCKET_MEDIA=vlk-media
S3_BUCKET_CLIPS=vlk-clips
S3_CREATE_BUCKETS=false

# Razorpay LIVE keys (Dashboard in Live Mode → Account & Settings → API Keys)
PAYMENT_PROVIDER=razorpay
PAYMENT_MERCHANT_NAME="Virtual Live Kitchen"
RAZORPAY_KEY_ID=rzp_live_change_me
RAZORPAY_KEY_SECRET=change_me
RAZORPAY_WEBHOOK_SECRET=change_me

# GST invoices for restaurant subscriptions
BILLING_SUPPLIER_LEGAL_NAME="Your Company Pvt Ltd"
BILLING_SUPPLIER_GSTIN=change_me
BILLING_SUPPLIER_ADDRESS="Registered address"
BILLING_SUPPLIER_STATE_CODE=29

# Background jobs: FFmpeg clip rendering threads (≈ CPU cores − 1) and AI analysis
JOB_WORKER_THREADS=2
JOB_HYGIENE_THREADS=1
HYGIENE_ENABLED=false
AI_SERVICE_API_KEY=change_me

# Error reporting
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0
