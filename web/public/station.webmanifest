{
  "name": "Virtual Live Kitchen — Station recorder",
  "short_name": "Station",
  "description": "Records a kitchen prep station and uploads the footage for each order.",
  "id": "/station",
  "start_url": "/station",
  "scope": "/station",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "any",
  "background_color": "#000000",
  "theme_color": "#000000",
  "icons": [
    { "src": "/icons/kitchen-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/kitchen-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/kitchen-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
