{
  "name": "Virtual Live Kitchen — Kitchen display",
  "short_name": "Kitchen",
  "description": "Live order board for chefs and restaurant owners.",
  "id": "/kitchen",
  "start_url": "/kitchen",
  "scope": "/kitchen",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "landscape",
  "background_color": "#0c0a09",
  "theme_color": "#1c1917",
  "icons": [
    { "src": "/icons/kitchen-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/kitchen-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/kitchen-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
