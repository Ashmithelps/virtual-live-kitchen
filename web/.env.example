# Backend API base URL as seen from the browser (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Backend URL as seen from the Next.js server (session route handlers). Defaults to NEXT_PUBLIC_API_URL.
API_URL=http://localhost:8080

# Payments: no keys here. The backend returns Razorpay's public key id with each checkout,
# and the key secret must only ever live in the backend.

# Development only (`npm run dev`): the header's role switcher logs in as the backend's dev-seed
# accounts with this password. Must match the backend's DEV_SEED_PASSWORD. Ignored by production builds.
DEV_SEED_PASSWORD=change_me_dev_password

# Public address of this web app (no trailing slash), used for absolute link-preview URLs (og:image).
# Must match the backend's WEB_BASE_URL, which builds the share links.
SITE_URL=http://localhost:3000

# ── Production (Vercel → Project → Settings → Environment Variables; see PRODUCTION.md) ──
# Shared with the backend (BACKEND_PROXY_SECRET): passes each visitor's IP to the backend's rate limiter.
BACKEND_PROXY_SECRET=
# Sentry (empty DSN = off). NEXT_PUBLIC_* values are baked in at build time.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# Source-map upload during `next build` (production only).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Legal pages (/privacy, /terms, /recording-consent). Empty values show as highlighted placeholders.
LEGAL_ENTITY_NAME=
LEGAL_ADDRESS=
LEGAL_SUPPORT_EMAIL=
LEGAL_JURISDICTION_CITY=
LEGAL_EFFECTIVE_DATE=
# DPDP Act grievance officer (shown on /privacy and /terms).
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=
GRIEVANCE_OFFICER_PHONE=
# true once a lawyer has approved the legal text (hides the "draft" banner).
LEGAL_PAGES_REVIEWED=false
