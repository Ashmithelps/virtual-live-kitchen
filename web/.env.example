# Backend API base URL as seen from the browser (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Backend URL as seen from the Next.js server (session route handlers). Defaults to NEXT_PUBLIC_API_URL.
API_URL=http://localhost:8080

# Payments: no keys here. The backend returns Razorpay's public key id with each checkout,
# and the key secret must only ever live in the backend.
