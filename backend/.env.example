# Database
DB_URL=jdbc:postgresql://localhost:5433/virtualkitchen
DB_USERNAME=vk_user
DB_PASSWORD=change_me

# JWT (secret must be >= 32 bytes; generate with: openssl rand -base64 48)
JWT_SECRET=change_me_at_least_32_chars_long
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d

# Login rate limit (per phone number)
LOGIN_RATE_LIMIT_CAPACITY=5
LOGIN_RATE_LIMIT_REFILL_PERIOD=15m

# Seeded ADMIN account (created on startup if the phone is not registered yet)
ADMIN_NAME="Platform Admin"
ADMIN_PHONE=+910000000000
ADMIN_PASSWORD=change_me_admin_password

# Dev seed (only with SPRING_PROFILES_ACTIVE=local,dev-seed; never in production).
# Password for all demo accounts (+919000000001 admin … +919000000005 customer), 12–72 characters.
DEV_SEED_PASSWORD=change_me_dev_password

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change_me
S3_BUCKET_CLIPS=clips
S3_BUCKET_MEDIA=media
S3_UPLOAD_URL_TTL=10m
S3_DOWNLOAD_URL_TTL=1h
S3_CREATE_BUCKETS=true
# A station phone's footage request is closed as NOT_AVAILABLE if not uploaded within this time.
CLIP_UPLOAD_TIMEOUT=2h

# Clip processing (FFmpeg) and retention
CLIP_RETENTION=30d
CLIP_RAW_RETENTION=24h
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_TIMEOUT=10m
CLIP_WATERMARK="Virtual Live Kitchen"
# Lifetime of clip watch/download/share-page links
CLIP_WATCH_URL_TTL=10m

# Background jobs: worker threads in this instance (0 = none)
JOB_WORKER_THREADS=1
JOB_POLL_INTERVAL=2s
JOB_LEASE=20m
JOB_MAX_ATTEMPTS=5
JOB_RETRY_BASE_DELAY=30s
# Threads for AI hygiene analysis jobs (separate from clip rendering)
JOB_HYGIENE_THREADS=1

# AI hygiene scoring (ai-service). Off until the service runs with real PPE weights.
HYGIENE_ENABLED=false
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=change_me
AI_SERVICE_TIMEOUT=5m
# Storage endpoint as the AI service sees it (docker-compose: http://minio:9000); empty = S3_ENDPOINT
AI_VIDEO_S3_ENDPOINT=
HYGIENE_WINDOW=30d
HYGIENE_MIN_PUBLIC_CLIPS=20
S3_REGION=ap-south-1

# App
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Orders & payments
ORDER_TAX_RATE_BPS=500
# Payments: "razorpay" or "mock" (mock approves every payment; development only).
PAYMENT_PROVIDER=mock
PAYMENT_MERCHANT_NAME="Virtual Live Kitchen"
# Razorpay test-mode keys: Dashboard (Test Mode) → Account & Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_change_me
RAZORPAY_KEY_SECRET=change_me
# Dashboard → Account & Settings → Webhooks → (your secret); events: payment.captured, payment.failed, refund.processed,
# subscription.authenticated, subscription.activated, subscription.charged, subscription.pending, subscription.halted,
# subscription.cancelled, subscription.completed
RAZORPAY_WEBHOOK_SECRET=change_me
# Route (chef tips go straight to chefs' linked accounts): business profile for new linked accounts
RAZORPAY_ROUTE_CATEGORY=food
RAZORPAY_ROUTE_SUBCATEGORY=restaurant

# Restaurant subscriptions. Trial and grace are defaults; admins change them at runtime (Admin → Billing).
BILLING_TRIAL_DAYS=30
BILLING_GRACE_DAYS=7
BILLING_GST_RATE_BPS=1800
# SAC code on invoices (998315 = hosting/IT infrastructure services); confirm with your accountant.
BILLING_SAC_CODE=998315
BILLING_INVOICE_PREFIX=VLK
# The platform as the supplier on GST invoices. The state code is the first two digits of the GSTIN.
BILLING_SUPPLIER_LEGAL_NAME="Virtual Live Kitchen Pvt Ltd"
BILLING_SUPPLIER_GSTIN=29AAAAA0000A1Z5
BILLING_SUPPLIER_ADDRESS="Change me, Bengaluru, Karnataka 560001"
BILLING_SUPPLIER_STATE_CODE=29

# Tips (paise). Platform share in basis points: 0 = the chef gets 100%.
TIP_PLATFORM_FEE_BPS=0
TIP_MIN_PAISE=1000
TIP_MAX_PAISE=500000

# Customer web app (encoded in table QR codes as <WEB_BASE_URL>/t/<token>)
WEB_BASE_URL=http://localhost:3000
TABLE_SESSION_TTL=4h
GUEST_ORDER_TOKEN_TTL=12h

DEV_SEED_PASSWORD=ashmitthakur2020

# ── Production hardening (see PRODUCTION.md; the prod profile is SPRING_PROFILES_ACTIVE=prod) ──
# Per-client-IP limits on public endpoints (requests per minute). Never false in production.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=30
RATE_LIMIT_PUBLIC_WRITE_PER_MINUTE=60
RATE_LIMIT_PUBLIC_READ_PER_MINUTE=300
# Shared with the web app's server (web: BACKEND_PROXY_SECRET); lets it pass on each visitor's IP. openssl rand -hex 32
BACKEND_PROXY_SECRET=
# Sentry error reporting (empty DSN = off).
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0
# Swagger UI and /v3/api-docs (off by default under the prod profile).
API_DOCS_ENABLED=true
# Comma-separated ProductionGuard checks to waive, for a staging rehearsal only (e.g. razorpay-test-keys).
PRODUCTION_GUARD_ALLOW=
